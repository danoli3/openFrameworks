<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <OF_ROOT>$(MSBuildThisFileDirectory)\..\..\..\..\</OF_ROOT>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>kernel32.lib;user32.lib;gdi32.lib;winspool.lib;comdlg32.lib;advapi32.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;odbc32.lib;odbccp32.lib;wldap32.lib;mf.lib;mfplat.lib;mfuuid.lib;d3d11.lib;mfreadwrite.lib;xaudio2.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <ClCompile>
      <LanguageStandard>stdcpp23</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <CompileAs>CompileAsCpp</CompileAs>
      <AdditionalOptions>/Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="OF_ROOT">
      <Value>$(OF_ROOT)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
  </ItemGroup>
  <!-- Prebuilt libs (apothecary) are built with MSVC 14.44 (VS 2022 17.14); an older toolset can't link them (LNK2001 __std_find_*, __std_search_1, _Thrd_sleep_for). OF_MIN_VCTOOLS_VERSION=0 skips the check. -->
  <PropertyGroup>
    <OF_MIN_VCTOOLS_VERSION Condition="'$(OF_MIN_VCTOOLS_VERSION)'==''">14.44</OF_MIN_VCTOOLS_VERSION>
  </PropertyGroup>
  <Target Name="OFCheckVCToolsVersion" BeforeTargets="PrepareForBuild" Condition="'$(VCToolsVersion)'!='' and '$(OF_MIN_VCTOOLS_VERSION)'!='0'">
    <Error Condition="$([MSBuild]::VersionLessThan('$(VCToolsVersion)', '$(OF_MIN_VCTOOLS_VERSION)'))" Text="MSVC toolset $(VCToolsVersion) is older than $(OF_MIN_VCTOOLS_VERSION) which openFrameworks libs are built with - update Visual Studio (Visual Studio Installer > Update, VS 2022 17.14+ or VS 2026) or the link fails with LNK2001 __std_find_* / __std_search_1 / _Thrd_sleep_for" />
  </Target>
</Project>