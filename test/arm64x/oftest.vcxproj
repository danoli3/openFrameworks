<?xml version="1.0" encoding="utf-8"?>
<!-- ARM64X through MSBuild: BuildAsX on the ARM64EC configuration, libraries chosen by $(Platform) like openFrameworks' props -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64EC">
      <Configuration>Release</Configuration>
      <Platform>ARM64EC</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5D1F0E3A-6A9B-4C7E-9F3D-0A64A64A6400}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Platform)'=='ARM64EC'">
    <BuildAsX>true</BuildAsX>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)msbuild-out\$(Platform)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\</IntDir>
    <TargetName>oftest</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>libs\zlib\include;libs\libpng\include;libs\pugixml\include</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)libs\zlib\lib\vs\$(Platform);$(ProjectDir)libs\libpng\lib\vs\$(Platform);$(ProjectDir)libs\pugixml\lib\vs\$(Platform)</AdditionalLibraryDirectories>
      <AdditionalDependencies>zlib.lib;libpng.lib;pugixml.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <!-- BuildAsX links the ARM64 code too, but only with the ARM64EC $(Platform) libraries:
       give it the ARM64 libraries by full path (same names in both folders) -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='ARM64EC' and '$(BuildAsX)'=='true'">
    <Link>
      <AdditionalDependencies>$(ProjectDir)libs\zlib\lib\vs\ARM64\zlib.lib;$(ProjectDir)libs\libpng\lib\vs\ARM64\libpng.lib;$(ProjectDir)libs\pugixml\lib\vs\ARM64\pugixml.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="oftest.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
